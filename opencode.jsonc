{
  "$schema": "https://opencode.ai/config.json",

  // Reference the existing project conventions
  "instructions": ["AGENTS.md"],

  // Avoid watching large build artifacts
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/.pytest_cache/**",
      "**/.ruff_cache/**",
      "**/dist/**",
      "**/build/**",
      "**/.venv/**",
      "**/*.egg-info/**",
      "logs/**",
      "downloads/**",
      "data/**",
      "config/**",
      "**/.idea/**",
      ".opencode/requirements/",
      ".opencode/designs/",
      ".opencode/issues/"
    ]
  },

  "permission": "allow",

  "command": {
    "req": {
      "template": "在 .opencode/requirements/ 下创建需求文档。先调研现有代码确认需求是否已实现，然后按模板创建 $ARGUMENTS.md，模板参考 .opencode/requirements/.template.md",
      "description": "创建需求文档"
    },
    "design": {
      "template": "在 .opencode/designs/ 下创建技术方案。先读取关联的需求文档，再调研相关代码，然后按模板输出方案到 $ARGUMENTS.md，模板参考 .opencode/designs/.template.md",
      "description": "创建技术方案"
    },
    "bug": {
      "template": "在 .opencode/issues/ 下创建缺陷报告。先搜索是否已有相同 issue，然后按模板创建，模板参考 .opencode/issues/.template.md。如果涉及代码问题，分析根因后附上修复建议",
      "description": "报告缺陷"
    },
    "remember": {
      "template": "请将以下信息持久化记录到 AGENTS.md 的「项目记忆」区域，找到对应的分类段落追加，格式为「- YYYY-MM-DD: 内容」：\n\n$ARGUMENTS",
      "description": "记录一条记忆到 AGENTS.md"
    },
    "recall": {
      "template": "请阅读 AGENTS.md 的「项目记忆」部分，搜索与以下主题相关的所有记忆条目，然后汇总回答：\n\n$ARGUMENTS",
      "description": "搜索 AGENTS.md 中的历史记忆"
    }
  },

  "agent": {
    "analyze": {
      "description": "需求分析和技术方案设计。分析需求文档 (.opencode/requirements/)、调研现有代码、输出技术方案到 .opencode/designs/。当需要开始新功能、理解需求、输出设计方案时使用",
      "mode": "subagent",
      "model": "supxh/deepseek-v4-pro",
      "prompt": "你负责需求分析和技术方案设计。工作流程：\n1. 读取 .opencode/requirements/ 下的需求文档理解需求\n2. 调研相关代码了解现状\n3. 输出技术方案到 .opencode/designs/，使用 .opencode/designs/.template.md 模板\n4. 方案需包含：技术选型理由、接口设计、数据模型变更、风险点"
    },
    "review": {
      "description": "代码审查。检查代码质量、安全性、规范遵循情况、与设计方案的一致性。当需要 review 代码变更、合并前检查时使用",
      "mode": "subagent",
      "model": "supxh/deepseek-v4-pro",
      "prompt": "你负责代码审查。检查要点：\n1. 代码是否符合 AGENTS.md 约定的规范\n2. 是否存在安全漏洞或性能问题\n3. 实现是否与对应的设计方案 (.opencode/designs/) 一致\n4. 边界条件和错误处理是否完整\n5. 测试覆盖是否充分"
    },
    "test": {
      "description": "测试开发与执行。编写测试、运行测试套件、分析失败原因并修复。当需要补测试、排查 CI 失败、验证修改正确性时使用",
      "mode": "subagent",
      "model": "supxh/deepseek-v4-flash",
      "prompt": "你负责测试工作。项目测试方式：\n- 后端/ SDK / 插件：`pipenv run pytest`\n- 桌面端：`node --test tests/<name>.test.mjs`\n- 前端不需要测试\n\n工作流程：\n1. 先了解对应需求的验收标准 (.opencode/requirements/) 或设计方案 (.opencode/designs/)\n2. 运行相关测试识别失败\n3. 修复后再验证通过"
    }
  }
}

{
  "entrypoint": "squirrel_bilibili.runtime:get_plugin_runtime",
  "manifest": {
    "plugin_id": "bilibili",
    "version": "0.1.0",
    "sdk_api_version": "2.0",
    "display_name": "Bilibili",
    "description": "Bilibili crawl integration",
    "capabilities": [
      {
        "name": "check_login_status",
        "description": "Check the current Bilibili login state.",
        "response_schema": {
          "type": "object"
        },
        "timeout_ms": 15000
      },
      {
        "name": "import_subscriptions",
        "description": "Import followed Bilibili creators for the current account.",
        "response_schema": {
          "type": "object"
        },
        "timeout_ms": 30000
      },
      {
        "name": "resolve_subscription",
        "description": "Resolve subscription metadata for a Bilibili creator or collection URL.",
        "response_schema": {
          "type": "object"
        },
        "timeout_ms": 30000
      },
      {
        "name": "sync_subscription",
        "description": "Fetch subscription video URLs for a Bilibili subscription.",
        "response_schema": {
          "type": "object"
        },
        "timeout_ms": 120000
      },
      {
        "name": "extract_video",
        "description": "Extract structured metadata for a Bilibili video URL.",
        "response_schema": {
          "type": "object"
        },
        "timeout_ms": 30000
      },
      {
        "name": "fetch_subtitles",
        "description": "Fetch subtitles for a Bilibili video.",
        "response_schema": {
          "type": "object"
        },
        "timeout_ms": 30000
      },
      {
        "name": "resolve_proxy_config",
        "description": "Resolve proxy headers and transport settings for Bilibili streams.",
        "response_schema": {
          "type": "object"
        },
        "timeout_ms": 15000
      }
    ],
    "sites": [
      {
        "site_name": "bilibili",
        "domains": [
          "bilibili.com",
          "b23.tv"
        ],
        "test_url": "https://www.bilibili.com",
        "metadata": {
          "label": "Bilibili",
          "aliases": [
            "bili"
          ],
          "http": {
            "headers": {
              "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3",
              "Referer": "https://www.bilibili.com",
              "Accept-Language": "en-US,en;q=0.9,zh-CN;q=0.8,zh;q=0.7"
            }
          },
          "rate_limit": {
            "enabled": true,
            "min_interval": 3.0,
            "max_interval": 5.0
          },
          "proxy": {
            "connect_timeout": 30.0,
            "read_timeout": 120.0,
            "write_timeout": 30.0,
            "pool_timeout": 30.0,
            "keepalive_expiry": 30.0,
            "max_connections": 50,
            "max_keepalive_connections": 50,
            "chunk_size": 2097152,
            "max_retries": 5,
            "enable_http2": true,
            "follow_redirects": true
          },
          "login": {
            "check_url": "https://api.bilibili.com/x/web-interface/nav",
            "headers": {
              "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36",
              "Referer": "https://www.bilibili.com"
            },
            "timeout": 15.0
          },
          "metadata": {
            "requires_cookies": true,
            "requires_login": true,
            "offline_thumbnails_download": true,
            "offline_thumbnails_display": false,
            "nsfw": false
          }
        },
        "features": [
          "check_login_status",
          "import_subscriptions",
          "resolve_subscription",
          "sync_subscription",
          "extract_video",
          "fetch_subtitles",
          "resolve_proxy_config"
        ]
      }
    ],
    "permissions": [
      {
        "name": "network:http",
        "description": "Access Bilibili APIs over HTTP.",
        "required": true
      },
      {
        "name": "cookies:read:site/bilibili",
        "description": "Read Bilibili cookies for authenticated requests.",
        "required": true
      }
    ],
    "health_policy": {
      "startup_timeout_ms": 10000
    }
  }
}

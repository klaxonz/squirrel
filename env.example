# ========================================
# 部署模式说明
# ========================================
# 完整部署：使用 docker-compose.yaml，包含 PostgreSQL 和 Redis 容器
# 独立部署：使用 docker-compose.standalone.yaml，连接已有的数据库和 Redis

# ========================================
# Redis 配置
# ========================================
# 完整部署：使用容器名称 "redis"
# 独立部署：使用外部 Redis 地址
#   - 同一台机器: host.docker.internal (Docker Desktop) 或 172.17.0.1 (Linux)
#   - 其他机器: IP地址或域名
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# 完整部署：默认密码
# 独立部署：改为实际的 Redis 密码
REDIS_PASSWORD=squirrel123

# ========================================
# PostgreSQL 配置
# ========================================
# 完整部署：使用容器名称 "postgres"
# 独立部署：使用外部 PostgreSQL 地址（配置说明同上 Redis）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 完整部署：默认密码
# 独立部署：改为实际的 PostgreSQL 密码
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=squirrel

# ========================================
# 下载配置
# ========================================
MEDIA_DOWNLOAD_PATH=/downloads

# ========================================
# Cookie 配置
# ========================================
# Cookie 类型: file | cloud
COOKIE_TYPE=file

# Cookie Cloud 配置（当 COOKIE_TYPE=cloud 时使用）
COOKIE_CLOUD_URL=
COOKIE_CLOUD_UUID=
COOKIE_CLOUD_PASSWORD=
COOKIE_CLOUD_DOMAIN=

# ========================================
# 数据库连接池配置
# ========================================
POOL_SIZE=30
POOL_MAX_SIZE=60
POOL_RECYCLE=300

# ========================================
# 频道更新配置
# ========================================
CHANNEL_UPDATE_DEFAULT_SIZE=30

# ========================================
# 运行环境
# ========================================
# 环境: dev | prod
ENV=prod

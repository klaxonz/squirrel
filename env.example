# ========================================
# 部署模式说明
# ========================================
# 单文件部署：使用 docker-compose.yaml，包含 PostgreSQL 和 Redis 容器
# 外部数据库/Redis：修改下方连接配置，并使用
#   docker compose up -d --no-deps squirrel squirrel-worker squirrel-scheduler

# 主服务端口（宿主机与容器内保持一致）
PORT=8001
# Cloudflare bypass 端口（宿主机与容器内保持一致）
CF_BYPASS_PORT=8002

# ========================================
# Redis 配置
# ========================================
# 容器内默认使用服务名 "redis"
# 如使用外部 Redis，请改为实际地址
#   - 同一台机器: host.docker.internal (Docker Desktop) 或 172.17.0.1 (Linux)
#   - 其他机器: IP地址或域名
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# 默认密码仅用于本地 compose
# 外部 Redis 请改为实际密码
REDIS_PASSWORD=squirrel123

# ========================================
# PostgreSQL 配置
# ========================================
# 容器内默认使用服务名 "postgres"
# 如使用外部 PostgreSQL，请改为实际地址（配置说明同上 Redis）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 默认密码仅用于本地 compose
# 外部 PostgreSQL 请改为实际密码
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=squirrel

# ========================================
# 下载配置
# ========================================
MEDIA_DOWNLOAD_PATH=/downloads
THUMBNAILS_DIR=./thumbnails
CLIP_MARKER_PREVIEWS_PATH=./clip-marker-previews

# ========================================
# 数据库连接池配置
# ========================================
POOL_SIZE=30
POOL_MAX_SIZE=60
POOL_RECYCLE=300

# ========================================
# 频道更新配置
# ========================================
CHANNEL_UPDATE_DEFAULT_SIZE=10

# ========================================
# CLOUD BY PASS Service
# ========================================
CLOUDFLARE_BYPASS_SERVICE_URL=http://squirrel-cf-bypass:8002

# ========================================
# CookieCloud
# ========================================
# Example:
# COOKIECLOUD_URL=http://host.docker.internal:8088
# COOKIECLOUD_UUID=your-device-uuid
# COOKIECLOUD_PASSWORD=your-cookiecloud-password
COOKIECLOUD_URL=
COOKIECLOUD_UUID=
COOKIECLOUD_PASSWORD=

# ========================================
# JWT
# ========================================
# Set a long random secret in production.
JWT_SECRET_KEY=change-me-in-env


# ========================================
# 运行环境
# ========================================
# 环境: dev | prod
ENV=prod

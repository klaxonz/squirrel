{
  "name": "squirrel",
  "version": "0.1.0",
  "private": true,
  "description": "Squirrel monorepo",
  "workspaces": [
    "squirrel-desktop",
    "squirrel-site-runtimes/youtube/src/squirrel_youtube/node"
  ],
  "scripts": {
    "dev:desktop": "npm -w squirrel-desktop run dev",
    "dev:renderer": "npm -w squirrel-desktop run dev:renderer",
    "build:desktop": "npm -w squirrel-desktop run build",
    "build:renderer": "npm -w squirrel-desktop run build:renderer",
    "typecheck": "npm -w squirrel-desktop run typecheck",
    "test": "npm -w squirrel-desktop run test:renderer",
    "test:desktop": "npm -w squirrel-desktop run test"
  }
}

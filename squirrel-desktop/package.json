{
  "name": "squirrel-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop shell for Squirrel",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.klaxon.squirrel.desktop",
    "productName": "Squirrel",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "axios": "^1.13.1",
    "bgutils-js": "^3.2.0",
    "jsdom": "^27.0.0",
    "proxy-agent": "^6.5.0",
    "youtubei.js": "^17.0.1"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1"
  }
}

{
  "name": "squirrel-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Squirrel desktop app (Electron + Vue renderer)",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder",
    "start": "electron .",
    "typecheck": "vue-tsc --noEmit -p renderer/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:renderer": "vitest run --config renderer/vitest.config.ts",
    "test:renderer:watch": "vitest --config renderer/vitest.config.ts",
    "lint": "eslint -c renderer/eslint.config.js renderer/src",
    "lint:fix": "eslint -c renderer/eslint.config.js renderer/src --fix",
    "postinstall": "npm run rebuild:electron-native",
    "rebuild:electron-native": "node ./scripts/rebuild-electron-native.mjs"
  },
  "build": {
    "appId": "com.klaxon.squirrel.desktop",
    "productName": "Squirrel",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "src/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.svg",
      "signExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "resources/icon.svg"
    },
    "linux": {
      "icon": "resources/icon.svg"
    }
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@tanstack/vue-query": "^5.101.0",
    "@vueuse/core": "^12.8.2",
    "axios": "^1.14.0",
    "clsx": "^2.1.1",
    "dashjs": "^4.7.3",
    "dompurify": "^3.4.12",
    "googlevideo": "^4.1.1",
    "hls.js": "^1.5.20",
    "kugoumusicapi": "https://github.com/MakcRe/KuGouMusicApi/archive/566de02034493af31c5a44f124429cbc1cb11b13.tar.gz",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "shaka-player": "^5.1.0",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.4.35",
    "vue-router": "^4.4.3",
    "vue-virtual-scroller": "2.0.0-beta.8",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "chokidar": "^3.6.0",
    "electron": "41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.4.1",
    "vite-plugin-checker": "^0.14.1",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.10.10",
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001780"
  }
}
